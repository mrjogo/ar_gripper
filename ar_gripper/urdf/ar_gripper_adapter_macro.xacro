<?xml version="1.0"?>
<robot name="ar_gripper_adapter"
  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ar_gripper_adapter" params="tf_prefix parent_link adapter_height:=0.006 adapter_mesh:=package://ar_gripper/meshes/adapter.stl">

    <link name="${tf_prefix}ar_gripper_adapter">
      <visual>
        <geometry>
          <mesh filename="${adapter_mesh}"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        <material name="${tf_prefix}Black">
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${adapter_mesh}"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.040" />
        <!-- These numbers are not correct -->
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${tf_prefix}ar_gripper_parent_adapter" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${tf_prefix}ar_gripper_adapter"/>
      <axis xyz="0 0 0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${tf_prefix}ar_gripper_adapter_attachment" />
    <joint name="${tf_prefix}ar_gripper_adapter_adapter_attachment" type="fixed">
      <parent link="${tf_prefix}ar_gripper_adapter"/>
      <child link="${tf_prefix}ar_gripper_adapter_attachment"/>
      <axis xyz="0 0 0"/>
      <origin rpy="0 0 0" xyz="0 0 ${adapter_height}"/>
    </joint>
  </xacro:macro>

</robot>