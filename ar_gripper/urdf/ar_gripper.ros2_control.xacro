<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Non-Gazebo ros2_control for the AR gripper backed by
       mock_components/GenericSystem. Mirrors commanded position to state with no
       physics, for fast/deterministic end-to-end testing without a simulator.
       Joint names and the GripperActionController joint (finger1) match
       ar_gripper_gz.ros2_control.xacro so MoveIt/controller configs are unchanged. -->
  <xacro:macro name="ar_gripper_mock_ros2_control" params="
    name
    tf_prefix
    ">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>

      <joint name="${tf_prefix}${name}_ar_gripper_body_finger1">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.05</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.03</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <!-- finger2 mimics finger1 in the URDF; GenericSystem mirrors it via the
           mimic tag, so it is state-only here (matches the Gazebo variant). -->
      <joint name="${tf_prefix}${name}_ar_gripper_body_finger2">
        <state_interface name="position">
          <param name="initial_value">0.03</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
