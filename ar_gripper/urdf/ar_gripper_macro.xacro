<?xml version="1.0" encoding="UTF-8"?>
<robot name="ar_gripper"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="ar_gripper" params="tf_prefix sim:=false">

    <!-- These are the mechanism's real travel limits. They were previously padded by
         10 mm at each end to work around
         https://github.com/ros-controls/gz_ros2_control/issues/165 (a joint commanded
         to its limit could stick there). The padding was unconditional, so a Gazebo
         workaround also shipped in the real robot's description, and it removed the
         only hard stop a simulator has - a gripper homing routine that closes until it
         feels load then has nothing to push against.

         Whether that Gazebo bug still exists on current gz_ros2_control is UNVERIFIED;
         the upstream issue is still open and marked wontfix. If it resurfaces, gate the
         padding on the simulator rather than applying it everywhere. -->
    <xacro:property name="FINGER_LOWER_LIMIT" value="0.0" />
    <xacro:property name="FINGER_UPPER_LIMIT" value="0.05" />
    <xacro:property name="FINGER_BODY_GAP" value="0.0005" />

    <!-- Finger velocity limit: PROVISIONAL, 0.031 m/s, and it MUST be confirmed by
         timing a full open/close on the real gripper.

         It is written as a literal on both <limit> elements below rather than as a
         xacro property because the Isaac servo backend reads this file as plain XML to
         avoid keeping a fourth copy of the number; a ${...} expression there would not
         parse. If this ever has to become a property, teach that reader to expand
         xacro instead of just moving the value.

         Where 0.031 comes from. The finger's 0.05 m stroke spans 3945 encoder ticks on
         a 4096 tick/rev encoder, i.e. 51.9 mm of finger travel per motor revolution.
         The driver commands the servo at 122500 steps/s (Gripper._init_servo); the
         value that actually goes on the wire is 122500 // 50 = 2450 steps/s, which at
         78900 ticks/m is 0.031 m/s = 36 rpm. An STS3215 free-runs around 45 rpm, so
         36 rpm loaded is mechanically sane.

         The previous value here was 0.0031 m/s, i.e. 3.6 rpm, exactly 10x smaller.
         Nothing derives it: `git log -S0.0031` finds no commit that introduced it, it
         predates the directory move, and every timeout in gripper.py (the 20 s move
         timeout, the 20 s wait-for-stop, the 0.3 s inrush window) is sized for a move
         of order one second, not the 16 s a full stroke takes at 3.6 rpm. A dropped
         decimal explains both numbers. Under Isaac the old value was binding and hard:
         a full 0.05 m stroke could not complete inside the driver's own timeout. -->

    <material name="${tf_prefix}Black">
      <color rgba="0.1 0.1 0.1 0.99"/>
    </material>

    <link name="${tf_prefix}ar_gripper_mount" />

    <link name="${tf_prefix}ar_gripper_body">
      <visual>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/body.stl"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        <material name="${tf_prefix}Black">
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/body.stl"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.400" />
        <!-- These numbers are not correct -->
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${tf_prefix}ar_gripper_mount_body" type="fixed">
      <parent link="${tf_prefix}ar_gripper_mount"/>
      <child link="${tf_prefix}ar_gripper_body"/>
      <axis xyz="0 0 0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${tf_prefix}ar_gripper_finger1">
      <visual>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/finger.stl"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <material name="${tf_prefix}Black">
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/finger.stl"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.040"/>
        <!-- These numbers are not correct -->
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${tf_prefix}ar_gripper_body_finger1" type="prismatic">
      <limit effort="1000.0" lower="${FINGER_LOWER_LIMIT}" upper="${FINGER_UPPER_LIMIT}" velocity="0.031"/>
      <parent link="${tf_prefix}ar_gripper_body"/>
      <child link="${tf_prefix}ar_gripper_finger1"/>
      <axis xyz="-1 0 0"/>
      <origin rpy="0 0 0" xyz="0.0 0 ${0.0756 + FINGER_BODY_GAP}"/>
      <dynamics damping="0.3" />
    </joint>

    <link name="${tf_prefix}ar_gripper_finger2">
      <visual>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/finger.stl"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <material name="${tf_prefix}Black">
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar_gripper/meshes/finger.stl"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.040"/>
        <!-- These numbers are not correct -->
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${tf_prefix}ar_gripper_body_finger2" type="prismatic">
      <limit effort="1000.0" lower="${FINGER_LOWER_LIMIT}" upper="${FINGER_UPPER_LIMIT}" velocity="0.031"/>
      <parent link="${tf_prefix}ar_gripper_body"/>
      <child link="${tf_prefix}ar_gripper_finger2"/>
      <axis xyz="-1 0 0"/>
      <mimic joint="${tf_prefix}ar_gripper_body_finger1" multiplier="1.0" offset="0.0" />
      <origin rpy="0 0 ${pi}" xyz="0.0 0 ${0.0756 + FINGER_BODY_GAP}"/>
      <dynamics damping="0.3" />
    </joint>

  </xacro:macro>
</robot>
