<?xml version="1.0" ?>
<robot name="za"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find ar_gripper)/urdf/ar_gripper_macro.xacro"/>
  <xacro:include filename="$(find ar_gripper)/urdf/ar_gripper_adapter_macro.xacro"/>

  <xacro:property name="tf_prefix" value="primary_" />

  <material name="${tf_prefix}Red">
    <color rgba="0.7 0.0 0.0 0.99"/>
  </material>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <material name="${tf_prefix}Red"/>
    </visual>
  </link>
  <joint name="world-base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="gripper_attachment" />
  <joint name="base-gripper_attachment" type="fixed">
    <parent link="base_link"/>
    <child link="gripper_attachment"/>
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
  </joint>

  <xacro:ar_gripper_adapter tf_prefix="${tf_prefix}"/>
  <joint name="base-ar_gripper_adapter_mount" type="fixed">
    <parent link="gripper_attachment"/>
    <child link="${tf_prefix}ar_gripper_adapter_mount"/>
    <axis xyz="0 0 0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <xacro:ar_gripper tf_prefix="${tf_prefix}"/>
  <joint name="adapter_attachment-ar_gripper_mount" type="fixed">
    <parent link="${tf_prefix}ar_gripper_adapter_attachment"/>
    <child link="${tf_prefix}ar_gripper_mount"/>
    <axis xyz="0 0 0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>


  <xacro:include filename="$(find ar_gripper)/urdf/ar_gripper_gz.ros2_control.xacro" />
  <xacro:ar_gripper_ros2_control name="primary" tf_prefix="" />

  <!-- Gazebo -->
  <gazebo reference="world">
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find ar_gripper)/config/ar_gripper_sim_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
